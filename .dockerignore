# Send only files required to build the workspaces.
**
!package.json
!bun.lock
!scripts
!scripts/workspaces.mjs
!core
!core/package.json
!core/tsconfig.json
!core/tsdown.config.ts
!core/src
!core/src/**
!web
!web/package.json
!web/vite.config.ts
!web/tsconfig.json
!web/src
!web/src/**
!web/static
!web/static/**
!server
!server/package.json
!server/tsconfig.json
!server/tsdown.config.ts
!server/src
!server/src/**
!server/drizzle
!server/drizzle/**
!cli
!cli/package.json
!cli/tsconfig.json
!cli/tsdown.config.ts
!cli/src
!cli/src/**
!LICENSE*

# Local installs and outputs are rebuilt inside the image.
**/node_modules
**/dist
**/build
**/.svelte-kit

# Keep credentials excluded even inside an allowed source directory.
**/.env
**/.env.*
**/.dev.vars
