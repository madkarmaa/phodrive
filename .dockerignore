# Send only files required to build the workspaces.
**
!package.json
!bun.lock
!scripts
!scripts/workspaces.mjs
!core
!core/package.json
!core/tsconfig.json
!core/tsdown.config.ts
!core/src
!core/src/**
!app
!app/package.json
!app/vite.config.ts
!app/tsconfig.json
!app/tsdown.config.ts
!app/src
!app/src/**
!app/static
!app/static/**
!app/drizzle
!app/drizzle/**
!cli
!cli/package.json
!cli/tsconfig.json
!cli/tsdown.config.ts
!cli/src
!cli/src/**
!LICENSE*

# Keep credentials excluded even inside an allowed source directory.
**/.env
**/.env.*
**/.dev.vars
