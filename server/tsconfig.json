{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "types": ["node"]
    },
    "include": ["src", "tests", "vitest.config.ts", "tsdown.config.ts", "drizzle.config.ts"]
}
