{
    "version": "1.4.1",
    "description": "Files worth a thousand pixels.",
    "author": "madkarmaa",
    "repository": {
        "type": "git",
        "url": "https://github.com/madkarmaa/phodrive"
    },
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=24.21.0"
    },
    "name": "@madkarmaa/phodrive-app",
    "private": true,
    "imports": {
        "#build-handler": {
            "types": "./src/build-handler.d.ts",
            "default": "./build/handler.js"
        },
        "#lib/*": "./src/lib/*.ts",
        "#components/*": "./src/lib/components/*",
        "#browser/*": "./src/lib/browser/*.ts",
        "#server/*": "./src/lib/server/*.ts",
        "#assets/*": "./src/lib/assets/*",
        "#browser/files": "./src/lib/browser/files/index.ts"
    },
    "scripts": {
        "dev": "drizzle-kit migrate && vite dev --host 127.0.0.1",
        "build": "vite build && tsdown",
        "preview": "drizzle-kit migrate && vite preview",
        "start": "cross-env HOST=127.0.0.1 PORT=3000 BODY_SIZE_LIMIT=Infinity node --env-file-if-exists=../.env build/server.js",
        "start:bun": "bunx --bun cross-env HOST=127.0.0.1 PORT=3000 BODY_SIZE_LIMIT=Infinity bun --env-file=../.env build/server.js",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "test": "vitest run",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "prepare": "svelte-kit sync"
    },
    "dependencies": {
        "@fontsource-variable/google-sans-flex": "^5.3.1",
        "@madkarmaa/phodrive-core": "^1.4.1",
        "better-auth": "^1.7.14",
        "cross-env": "^10.1.0",
        "drizzle-orm": "^0.45.4",
        "hono": "^4.13.14",
        "noph-ui": "^0.51.2",
        "postgres": "^3.4.9",
        "pretty-bytes": "^7.2.0",
        "results-ts": "^4.4.0",
        "runed": "^0.37.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@iconify-json/material-symbols": "^1.2.95",
        "@sveltejs/adapter-node": "^6.0.0",
        "@sveltejs/kit": "^3.0.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.19.2",
        "drizzle-kit": "^0.31.11",
        "esm-env": "^1.2.2",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.6",
        "tailwindcss": "^4.3.3",
        "tsdown": "^0.23.2",
        "typescript": "^6.0.3",
        "unplugin-icons": "^24.0.0",
        "vite": "^8.3.4",
        "vitest": "^5.0.3"
    }
}
