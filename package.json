{
    "name": "phodrive",
    "private": true,
    "version": "1.3.0",
    "license": "MIT",
    "description": "Files worth a thousand pixels.",
    "author": "madkarmaa",
    "repository": {
        "type": "git",
        "url": "https://github.com/madkarmaa/phodrive"
    },
    "type": "module",
    "engines": {
        "node": "^22.22.2 || >=24.15.0"
    },
    "imports": {
        "#build-handler": {
            "types": "./src/build-handler.d.ts",
            "default": "./build/handler.js"
        }
    },
    "scripts": {
        "dev": "vite dev --host 127.0.0.1",
        "build": "vite build && tsc --project tsconfig.server.json",
        "preview": "vite preview",
        "start": "cross-env HOST=127.0.0.1 PORT=3000 BODY_SIZE_LIMIT=Infinity node build/server.js",
        "start:bun": "bunx --bun cross-env HOST=127.0.0.1 PORT=3000 BODY_SIZE_LIMIT=Infinity bun build/server.js",
        "test": "vitest run",
        "prepare": "husky && svelte-kit sync",
        "commitlint": "commitlint",
        "release": "semantic-release",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check .",
        "format": "prettier --write .",
        "perf": "node scripts/performance.mjs",
        "perf:check": "tsc --project benchmarks/tsconfig.json"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@iconify-json/material-symbols": "^1.2.93",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.10",
        "@semantic-release/npm": "^13.2.0",
        "@semantic-release/release-notes-generator": "^14.1.1",
        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.3",
        "@types/varint": "^6.0.3",
        "conventional-changelog-conventionalcommits": "^9.3.1",
        "conventional-commits-filter": "^6.0.1",
        "conventional-commits-parser": "^7.1.2",
        "husky": "^9.1.7",
        "prettier": "^3.9.9",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "semantic-release": "^25.0.9",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.6",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "unplugin-icons": "^24.0.0",
        "vite": "^8.3.1",
        "vitest": "^5.0.3"
    },
    "dependencies": {
        "@fastify/busboy": "^3.2.2",
        "@fontsource-variable/google-sans-flex": "^5.3.1",
        "cross-env": "^10.1.0",
        "eventsource-parser": "^4.1.1",
        "hash-wasm": "^4.12.0",
        "noph-ui": "^0.49.0",
        "p-limit": "^7.3.3",
        "pretty-bytes": "^7.2.0",
        "results-ts": "^4.2.6",
        "runed": "^0.37.1",
        "undici": "^8.11.2",
        "varint": "^6.0.0",
        "zod": "^4.6.5"
    }
}
