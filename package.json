{
    "name": "phodrive",
    "private": true,
    "version": "1.4.1",
    "license": "MIT",
    "description": "Files worth a thousand pixels.",
    "author": "madkarmaa",
    "repository": {
        "type": "git",
        "url": "https://github.com/madkarmaa/phodrive"
    },
    "type": "module",
    "engines": {
        "node": ">=24.21.0"
    },
    "overrides": {
        "@sveltejs/kit": "^3.0.1",
        "conventional-changelog-writer": "^9.3.0"
    },
    "lint-staged": {
        "*": "prettier --write --ignore-unknown"
    },
    "workspaces": [
        "core",
        "web",
        "server",
        "cli"
    ],
    "scripts": {
        "dev": "node scripts/workspaces.mjs dev",
        "build": "node scripts/workspaces.mjs build",
        "start": "node scripts/workspaces.mjs start",
        "start:bun": "node scripts/workspaces.mjs start:bun",
        "cli": "node scripts/workspaces.mjs cli",
        "compile": "node scripts/workspaces.mjs compile",
        "test": "node scripts/workspaces.mjs test",
        "check": "node scripts/workspaces.mjs check",
        "check:watch": "node scripts/workspaces.mjs check:watch",
        "prepare": "husky && node scripts/workspaces.mjs prepare",
        "commitlint": "commitlint",
        "release": "semantic-release",
        "lint": "prettier --check .",
        "format": "prettier --write .",
        "perf": "node scripts/performance.mjs",
        "perf:check": "tsc --project benchmarks/tsconfig.json"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@madkarmaa/phodrive-core": "^1.4.1",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/exec": "^7.1.0",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.10",
        "@semantic-release/npm": "^13.2.0",
        "@semantic-release/release-notes-generator": "^14.1.1",
        "@types/node": "^24.19.2",
        "conventional-changelog-conventionalcommits": "^10.4.1",
        "conventional-commits-filter": "^6.0.1",
        "conventional-commits-parser": "^7.1.3",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "semantic-release": "^25.0.9",
        "typescript": "^6.0.3",
        "vitest": "^5.0.3"
    }
}
