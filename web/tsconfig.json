{
    "extends": "$app/tsconfig",
    "include": ["src", "tests", "*.ts", "*.js"],
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "types": ["$app/types", "node", "svelte"],
        "moduleResolution": "bundler"
    }
}
